RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

RewriteCond %{HTTP:X-Goog-Channel-Token} ^(.+)$
RewriteRule .* - [E=GOOG_CHANNEL_TOKEN:%1]

RewriteRule ^/?$ swagger.php [L]

RewriteRule ^iam/?$ php/iam.php [L,QSA]
RewriteRule ^iam/(.+)$ $1 [L,QSA]

RewriteRule ^(.+)/?$ php/api.php?path=/$1 [L,QSA]

RewriteCond %{QUERY_STRING} ^(.*)$