cd Portal
npx lint-staged
cd ..

cd Cortex
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^Cortex/.*\.py$" | sed "s|^Cortex/||")
if [ -n "$STAGED_PY" ]; then
  echo "$STAGED_PY" | xargs python -m ruff check --fix
fi
cd ..

for PROJECT in Core Iam Common; do
  STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^${PROJECT}/.*\.php$" | sed "s|^${PROJECT}/||")
  if [ -n "$STAGED_PHP" ]; then
    php .tools/php-cs-fixer.phar fix --config="${PROJECT}/.php-cs-fixer.php" $( echo "$STAGED_PHP" | sed "s|^|${PROJECT}/|" )
  fi
done