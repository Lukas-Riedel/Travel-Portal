#!/usr/bin/env sh
npx lint-staged --cwd Portal --config Portal/package.json --allow-empty

STAGED_PY_FULL=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^Cortex/.*\.py$" || true)
if [ -n "$STAGED_PY_FULL" ]; then
  PYTHON_BIN="python"
  if [ -f "Cortex/.venv/Scripts/python.exe" ]; then
    PYTHON_BIN=".venv/Scripts/python.exe"
  elif [ -f "Cortex/.venv/bin/python" ]; then
    PYTHON_BIN=".venv/bin/python"
  fi
  STAGED_PY=$(echo "$STAGED_PY_FULL" | sed "s|^Cortex/||")
  (cd Cortex && echo "$STAGED_PY" | xargs "$PYTHON_BIN" -m ruff format) || exit 1
  (cd Cortex && echo "$STAGED_PY" | xargs "$PYTHON_BIN" -m ruff check --fix) || exit 1
  (cd Cortex && echo "$STAGED_PY" | xargs "$PYTHON_BIN" scripts/check_style.py) || exit 1
  echo "$STAGED_PY_FULL" | xargs git add
fi

for PROJECT in Core Iam Common; do
  STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^${PROJECT}/.*\.php$" | sed "s|^${PROJECT}/||" || true)
  if [ -n "$STAGED_PHP" ]; then
    php .tools/php-cs-fixer.phar fix --config="${PROJECT}/.php-cs-fixer.php" $( echo "$STAGED_PHP" | sed "s|^|${PROJECT}/|" )
    echo "$STAGED_PHP" | sed "s|^|${PROJECT}/|" | xargs git add
  fi
done
