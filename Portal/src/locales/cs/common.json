{
    "general": {
        "format": {
            "date": "dd.MM.yyyy"
        }
    },
    "menu": {
        "feed": "Nedávné",
        "trips": "Výlety",
        "places": "Místa",
        "flights": "Lety",
        "statistics": "Statistiky",
        "plan": "Plán",
        "tracker": "Tracker",
        "admin": "Admin"
    },
    "prompt": {
        "confirm": "Ano",
        "confirmed": "Akce byla úspěšně provedena",
        "reject": "Ne",
        "failed": "Při provádění akce došlo k chybě",
        "loading": "Probíhá zpracování..."
    },
    "airport": {
        "format": "Letiště {{name}}"
    },
    "airline": {
        "prompt": {
            "create": {
                "message": "Zadej název aerolinky k vytvoření:",
                "confirmed": "Aerolinka byla úspěšně vytvořena",
                "failed": "Při vytváření aerolinky došlo k chybě"
            },
            "update": {
                "message": "Zadej nové údaje o aerolince:",
                "label": {
                    "name": "Název",
                    "logo": "Logo",
                    "codes": "Kódy"
                },
                "confirmed": "Aerolinka byla úspěšně aktualizována",
                "failed": "Nepodařilo se aktualizovat aerolinku"
            },
            "remove": {
                "message": "Opravdu chceš odstranit aerolinku {{name}}?",
                "confirmed": "Aerolinka byla úspěšně odstraněna",
                "failed": "Nepodařilo se odstranit aerolinku"
            }
        }
    },
    "flight": {
        "prompt": {
            "log": {
                "message": "Opravdu chceš zalogovat vybraný let?",
                "confirmed": "Let byl úspěšně zalogovan",
                "failed": "Nepodařilo se zalogovat let"
            }
        }
    },
    "note": {
        "prompt": {
            "create": {
                "message": {
                    "input": "Zadej obsah poznámky:",
                    "confirm": "Opravdu chceš vytvořit novou poznámku?"
                },
                "confirmed": "Poznámka byla úspěšně vytvořena",
                "failed": "Nepodařilo se vytvořit poznámku"
            },
            "remove": {
                "message": "Opravdu chceš odstranit vybranou poznámku?",
                "confirmed": "Poznámka byla úspěšně odstraněna",
                "failed": "Nepodařilo se odstranit poznámku"
            }
        }
    },
    "subscription": {
        "format": "{{description}} (do {{expiration}})"
    },
    "voucher": {
        "format": {
            "expirable": "{{issuer}} {{value}} {{currency}} (do {{expiration}})",
            "nonexpirable": "{{issuer}} {{value}} {{currency}}"
        }
    },    
    "expense": {
        "prompt": {
            "create": {
                "message": "Opravdu chceš vytvořit nový výdaj?",
                "label": {
                    "subscription": "Předplatné",
