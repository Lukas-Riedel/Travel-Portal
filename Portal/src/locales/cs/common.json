                    "message": "Zadej nový popis výdaje:",
                    "confirmed": "Popis výdaje byl úspěšně aktualizován",
                    "failed": "Nepodařilo se aktualizovat popis výdaje"
                },
                "value": {
                    "message": "Zadej novou hodnotu a měnu výdaje:",
                    "label": {
                        "value": "Hodnota",
                        "currency": "Měna"
                    },
                    "confirmed": "Hodnota výdaje byla úspěšně aktualizována",
                    "failed": "Nepodařilo se aktualizovat hodnotu výdaje"
