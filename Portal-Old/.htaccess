RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Pages with arguments
RewriteRule ^year/([^/]+)/?$ year.php?year=$1 [L,QSA]
RewriteRule ^year/(.+)$ $1 [L,QSA]

RewriteRule ^trip/([^/]+)/?$ trip.php?tripId=$1 [L,QSA]
RewriteRule ^trip/(.+)$ $1 [L,QSA]

RewriteRule ^category/([^/]+)/?$ category.php?categoryId=$1 [L,QSA]
RewriteRule ^category/(.+)$ $1 [L,QSA]

RewriteRule ^label/([^/]+)/?$ label.php?label=$1 [L,QSA]
RewriteRule ^label/(.+)$ $1 [L,QSA]

RewriteRule ^plan/trip/([^/]+)/?$ plans_trip.php?tripId=$1 [L,QSA]
RewriteRule ^plan/trip/(.+)$ $1 [L,QSA]
RewriteRule ^plan/trip/?$ plans_trips.php [L,QSA]
RewriteRule ^plan/trip/(.+)$ $1 [L,QSA]
RewriteRule ^plan/([^/]+)/?$ plans.php?categoryId=$1 [L,QSA]
RewriteRule ^plan/(.+)$ $1 [L,QSA]

RewriteRule ^place/([^/]+)/album/([^/]+)/?$ album.php?placeId=$1&albumId=$2 [L,QSA]
RewriteRule ^place/([^/]+)/album/(.+)$ $1 [L,QSA]

RewriteRule ^place/([^/]+)/?$ place.php?placeId=$1 [L,QSA]
RewriteRule ^place/(.+)$ $1 [L,QSA]

RewriteRule ^acp/([^/]+)/?$ acp.php?apiKey=$1 [L,QSA]
RewriteRule ^acp/(.+)$ $1 [L,QSA]

# Pages without arguments
RewriteRule ^place/?$ places.php [L,QSA]
RewriteRule ^place/(.+)$ $1 [L,QSA]

RewriteRule ^plan/?$ plans.php [L,QSA]
RewriteRule ^plan/(.+)$ $1 [L,QSA]

RewriteRule ^trip/?$ trips.php [L,QSA]
RewriteRule ^trip/(.+)$ $1 [L,QSA]

RewriteRule ^statistics/?$ statistics.php [L,QSA]
RewriteRule ^statistics/(.+)$ $1 [L,QSA]

RewriteRule ^flight/?$ flights.php [L,QSA]
RewriteRule ^flight/(.+)$ $1 [L,QSA]

RewriteRule ^acp/?$ acp.php [L,QSA]
RewriteRule ^acp/(.+)$ $1 [L,QSA]

RewriteRule ^tracking/?$ time_tracking.php [L,QSA]
RewriteRule ^tracking/(.+)$ $1 [L,QSA]

RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^login/(.+)$ $1 [L,QSA]

RewriteRule ^tracker/?$ /new/tracker [R=302,L]

# React fallback for /new/*
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^new(/.*)?$ /new/index.html [L]